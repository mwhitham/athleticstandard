{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athleticstandard.dev/schema/0.1.0/athleticstandard.schema.json",
  "title": "Athletic Standard file",
  "type": "object",
  "properties": {
    "athleticstandard_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Format version (semver). Minor versions may only add optional fields."
    },
    "athlete": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "birth_year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "sex": {
          "type": "string",
          "enum": [
            "male",
            "female"
          ]
        },
        "units": {
          "description": "Display preference only — stored values are always canonical (metric) units",
          "type": "string",
          "enum": [
            "metric",
            "imperial"
          ]
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "description": "Identifier: lowercase alphanumeric with hyphens/underscores"
          },
          "kind": {
            "type": "string",
            "enum": [
              "wearable",
              "export_file",
              "connector",
              "manual"
            ]
          },
          "vendor": {
            "description": "e.g. whoop, oura, apple, garmin — omit for kind=manual",
            "type": "string"
          },
          "detail": {
            "description": "Human-readable provenance, e.g. 'WHOOP 4.0 via CSV export 2026-08-09'",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false,
        "description": "A provenance record. Every hard signal must reference one. `manual` exists so typed-in numbers can be stored as measurements without claiming device provenance."
      }
    },
    "hard_signals": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "hrv_rmssd"
                  },
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "type": "string",
                    "const": "ms",
                    "description": "Fixed canonical unit for this type — no ambiguous values"
                  },
                  "recorded_at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                    "description": "ISO 8601 timestamp with timezone (UTC `Z` or explicit offset)"
                  },
                  "source": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]*$",
                    "description": "Reference to sources[].id"
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "value",
                  "unit",
                  "recorded_at",
                  "source"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "hrv_sdnn"
                  },
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "type": "string",
                    "const": "ms",
                    "description": "Fixed canonical unit for this type — no ambiguous values"
                  },
                  "recorded_at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                    "description": "ISO 8601 timestamp with timezone (UTC `Z` or explicit offset)"
                  },
                  "source": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]*$",
                    "description": "Reference to sources[].id"
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "value",
                  "unit",
                  "recorded_at",
                  "source"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "resting_heart_rate"
                  },
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "type": "string",
                    "const": "bpm",
                    "description": "Fixed canonical unit for this type — no ambiguous values"
                  },
                  "recorded_at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                    "description": "ISO 8601 timestamp with timezone (UTC `Z` or explicit offset)"
                  },
                  "source": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]*$",
                    "description": "Reference to sources[].id"
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "value",
                  "unit",
                  "recorded_at",
                  "source"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "body_weight"
                  },
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "type": "string",
                    "const": "kg",
                    "description": "Fixed canonical unit for this type — no ambiguous values"
                  },
                  "recorded_at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                    "description": "ISO 8601 timestamp with timezone (UTC `Z` or explicit offset)"
                  },
                  "source": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]*$",
                    "description": "Reference to sources[].id"
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "value",
                  "unit",
                  "recorded_at",
                  "source"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "respiratory_rate"
                  },
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "type": "string",
                    "const": "brpm",
                    "description": "Fixed canonical unit for this type — no ambiguous values"
                  },
                  "recorded_at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                    "description": "ISO 8601 timestamp with timezone (UTC `Z` or explicit offset)"
                  },
                  "source": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]*$",
                    "description": "Reference to sources[].id"
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "value",
                  "unit",
                  "recorded_at",
                  "source"
                ],
                "additionalProperties": false
              }
            ],
            "description": "A single timestamped device measurement with a fixed canonical unit"
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "sleep_session"
              },
              "start": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "description": "ISO 8601 timestamp with timezone (UTC `Z` or explicit offset)"
              },
              "end": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "description": "ISO 8601 timestamp with timezone (UTC `Z` or explicit offset)"
              },
              "source": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$",
                "description": "Reference to sources[].id"
              },
              "aggregates": {
                "type": "object",
                "properties": {
                  "duration_s": {
                    "description": "Actual sleep, excluding awake time",
                    "type": "number",
                    "minimum": 0
                  },
                  "time_in_bed_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "efficiency_pct": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "deep_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "rem_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "light_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "awake_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "interruptions": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "start",
              "end",
              "source",
              "aggregates"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "workout_session"
              },
              "start": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "description": "ISO 8601 timestamp with timezone (UTC `Z` or explicit offset)"
              },
              "end": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "description": "ISO 8601 timestamp with timezone (UTC `Z` or explicit offset)"
              },
              "source": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$",
                "description": "Reference to sources[].id"
              },
              "aggregates": {
                "type": "object",
                "properties": {
                  "activity": {
                    "description": "Freeform activity label, e.g. 'crossfit', 'run', 'hyrox'",
                    "type": "string"
                  },
                  "avg_hr_bpm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "max_hr_bpm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "energy_kcal": {
                    "type": "number",
                    "minimum": 0
                  },
                  "distance_m": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              },
              "segments": {
                "description": "Ordered sub-efforts: run splits, HYROX station times",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "description": "e.g. 'run 1km', 'ski erg', 'sled push'"
                    },
                    "duration_s": {
                      "type": "number",
                      "minimum": 0
                    },
                    "distance_m": {
                      "type": "number",
                      "minimum": 0
                    },
                    "avg_hr_bpm": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "label"
                  ],
                  "additionalProperties": false
                }
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "start",
              "end",
              "source",
              "aggregates"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "benchmark_result"
              },
              "benchmark": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$",
                "description": "Reference to benchmarks[].id"
              },
              "recorded_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "description": "ISO 8601 timestamp with timezone (UTC `Z` or explicit offset)"
              },
              "source": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$",
                "description": "Reference to sources[].id"
              },
              "result": {
                "type": "object",
                "properties": {
                  "duration_s": {
                    "description": "For score_type=time",
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "reps": {
                    "description": "For score_type=reps",
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "weight_kg": {
                    "description": "For score_type=load",
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "additionalProperties": false
              },
              "scaling": {
                "type": "string",
                "enum": [
                  "rx",
                  "scaled"
                ]
              },
              "note": {
                "type": "string"
              }
            },
