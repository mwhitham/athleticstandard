              "type",
              "benchmark",
              "recorded_at",
              "source",
              "result"
            ],
            "additionalProperties": false
          }
        ],
        "description": "Tier 1: device-measured, high trust. Drives predictions. Every hard signal must reference a source."
      }
    },
    "soft_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "sleep_quality",
              "soreness",
              "stress",
              "mood",
              "energy",
              "nutrition",
              "note"
            ]
          },
          "reported_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "ISO 8601 timestamp with timezone (UTC `Z` or explicit offset)"
          },
          "rating": {
            "type": "number"
          },
          "scale": {
            "description": "Required when rating is present, e.g. '1-5'. Ratings without scales are meaningless.",
            "type": "string"
          },
          "body_region": {
            "description": "For soreness, e.g. 'quads', 'lower back'",
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "provenance": {
            "description": "Defaults to { via: 'text' } when absent",
            "type": "object",
            "properties": {
              "via": {
                "type": "string",
                "enum": [
                  "text",
                  "voice",
                  "photo"
                ]
              },
              "interpreted_by": {
                "description": "Model that interpreted the input, e.g. 'claude-sonnet-4-5'. Required for via=photo.",
                "type": "string"
              },
              "attachment": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "description": "Filename inside the sibling attachments/ folder"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "file",
                  "sha256"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "via"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "type",
          "reported_at"
        ],
        "additionalProperties": false,
        "description": "Tier 2: self-reported, low confidence. Adjusts prediction confidence and explains misses. Structurally cannot claim device provenance: there is no source field."
      }
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
